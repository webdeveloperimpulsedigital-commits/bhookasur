# ==========================================================
# Bakasur Ka Food Tour - Environment Configuration
# ==========================================================

# MySQL Database Credentials (Hostinger MySQL or Remote MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_username
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# App Configuration
NEXT_PUBLIC_APP_URL=https://gastrium.in/bhookasur_ka_food_tour
NEXT_PUBLIC_BASE_PATH=/bhookasur_ka_food_tour

# Admin Dashboard Authentication (IMPORTANT: Change for production security!)
# In production there is NO default password: admin login stays disabled until ADMIN_PASSWORD is set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
# Optional: long random string used to sign admin session cookies (defaults to a value derived from ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# Google Places API Key (Optional: for live place suggestions / geocoding)
GOOGLE_PLACES_API_KEY=

# Apify Swiggy Integration (Optional: for live Swiggy menu / restaurant scraping)
APIFY_TOKEN=
APIFY_SWIGGY_ACTOR=thirdwatch/swiggy-scraper

# Google Gemini API Key (Optional: for automated on-demand online AI food image generation when dishes lack Swiggy/Zomato photos)
GEMINI_API_KEY=

