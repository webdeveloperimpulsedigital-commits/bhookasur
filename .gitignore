# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archives
*.zip

# temporary scratch & debug
/scratch/

# dynamic food images cache (generated at runtime)
public/images/food/generated/*
!public/images/food/generated/cheese_maggi.jpg
!public/images/food/generated/club_sandwich.jpg
!public/images/food/generated/egg_puff.jpg
!public/images/food/generated/mawa_cake.jpg
!public/images/food/generated/paneer_chilli.jpg
!public/images/food/generated/rabri.jpg
!public/images/food/generated/veg_biryani.jpg
!public/images/food/generated/veg_manchurian.jpg
!public/images/food/generated/veg_puff.jpg
